{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scarecrow.project/schemas/decision.schema.json",
  "title": "Decision",
  "description": "DATA_TYPE_DECISIONS 批次中单条记录的结构 (来自 CrowdSec models.Decision)",
  "type": "object",
  "required": ["id", "origin", "type", "scope", "value", "duration"],
  "properties": {
    "id": {
      "type": "integer",
      "description": "决策 ID"
    },
    "origin": {
      "type": "string",
      "description": "决策来源",
      "enum": ["cscli", "crowdsec", "CAPI", "list", "console"]
    },
    "type": {
      "type": "string",
      "description": "决策类型",
      "enum": ["ban", "captcha", "throttle", "whitelist"]
    },
    "scope": {
      "type": "string",
      "description": "决策作用域",
      "enum": ["ip", "range", "as", "country"]
    },
    "value": {
      "type": "string",
      "description": "决策目标值 (IP/CIDR/AS/...)"
    },
    "duration": {
      "type": "string",
      "description": "持续时间 (如 '4h', '24h')",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$"
    },
    "scenario": {
      "type": "string",
      "description": "关联场景"
    },
    "simulated": {
      "type": "boolean",
      "description": "是否为模拟决策"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "创建时间"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "更新时间"
    }
  },
  "additionalProperties": false
}
