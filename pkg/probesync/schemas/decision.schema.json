{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scarecrow.project/schemas/decision.schema.json",
  "title": "Decision",
  "description": "decisions 批次中单条记录的结构",
  "type": "object",
  "required": ["id", "created_at", "updated_at", "scenario", "type", "scope", "value", "origin"],
  "properties": {
    "id": {
      "type": "integer",
      "description": "决策 ID"
    },
    "created_at": {
      "type": "string",
      "description": "创建时间"
    },
    "updated_at": {
      "type": "string",
      "description": "更新时间"
    },
    "until": {
      "type": "string",
      "description": "过期时间"
    },
    "scenario": {
      "type": "string",
      "description": "关联场景"
    },
    "type": {
      "type": "string",
      "description": "决策类型"
    },
    "start_ip": {
      "type": "integer",
      "description": "起始 IP"
    },
    "end_ip": {
      "type": "integer",
      "description": "结束 IP"
    },
    "start_suffix": {
      "type": "integer",
      "description": "起始后缀"
    },
    "end_suffix": {
      "type": "integer",
      "description": "结束后缀"
    },
    "ip_size": {
      "type": "integer",
      "description": "IP 大小"
    },
    "scope": {
      "type": "string",
      "description": "决策作用域"
    },
    "value": {
      "type": "string",
      "description": "决策目标值 (IP/CIDR/AS/...)"
    },
    "origin": {
      "type": "string",
      "description": "决策来源"
    },
    "simulated": {
      "type": "boolean",
      "description": "是否为模拟决策"
    },
    "uuid": {
      "type": "string",
      "description": "唯一标识"
    },
    "alert_decisions": {
      "type": "integer",
      "description": "关联告警 ID"
    }
  },
  "additionalProperties": false
}
