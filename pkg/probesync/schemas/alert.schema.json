{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scarecrow.project/schemas/alert.schema.json",
  "title": "Alert",
  "description": "alerts 批次中单条记录的结构",
  "type": "object",
  "required": ["id", "created_at", "updated_at", "scenario"],
  "properties": {
    "id": {
      "type": "integer",
      "description": "告警 ID"
    },
    "created_at": {
      "type": "string",
      "description": "创建时间"
    },
    "updated_at": {
      "type": "string",
      "description": "更新时间"
    },
    "scenario": {
      "type": "string",
      "description": "触发场景名称",
      "examples": ["crowdsecurity/http-probing", "crowdsecurity/ssh-bf"]
    },
    "bucket_id": {
      "type": "string",
      "description": "bucket_id"
    },
    "scenario_hash": {
      "type": "string",
      "description": "场景哈希"
    },
    "scenario_version": {
      "type": "string",
      "description": "场景版本"
    },
    "message": {
      "type": "string",
      "description": "告警消息"
    },
    "events_count": {
      "type": "integer",
      "description": "关联事件数量"
    },
    "started_at": {
      "type": "string",
      "description": "告警开始时间"
    },
    "stopped_at": {
      "type": "string",
      "description": "告警结束时间"
    },
    "capacity": {
      "type": "integer",
      "description": "桶容量"
    },
    "leak_speed": {
      "type": "string",
      "description": "泄漏速度"
    },
    "simulated": {
      "type": "boolean",
      "description": "是否为模拟告警"
    },
    "source_value": {
      "type": "string",
      "description": "攻击源值"
    },
    "source_scope": {
      "type": "string",
      "description": "攻击源作用域"
    },
    "source_ip": {
      "type": "string",
      "description": "攻击源 IP (scope=ip 时)"
    },
    "source_range": {
      "type": "string",
      "description": "攻击源 CIDR (scope=range 时)"
    },
    "source_as_number": {
      "type": "string",
      "description": "AS 编号 (scope=as 时)"
    },
    "source_as_name": {
      "type": "string",
      "description": "AS 名称"
    },
    "source_country": {
      "type": "string",
      "description": "国家"
    },
    "source_latitude": {
      "type": "number",
      "description": "纬度"
    },
    "source_longitude": {
      "type": "number",
      "description": "经度"
    },
    "uuid": {
      "type": "string",
      "description": "唯一标识"
    },
    "remediation": {
      "type": "boolean",
      "description": "是否需要 remediation"
    },
    "machine_alerts": {
      "type": "integer",
      "description": "关联机器 ID"
    }
  },
  "additionalProperties": false
}
